# Copie para .env e preencha conforme necessario.
# NUNCA comitar .env real em repositorio publico.

# ----- Banco de dados (opcional; padrao: SQLite local) -----
# FEG_DB_URL=sqlite:///data/db/feg_research.db

# ----- Google Earth Engine -----
# Preencha com o ID do projeto Google Cloud registrado para Earth Engine.
# Deixe em branco para desabilitar NDVI.
FEG_GEE_PROJECT=

# ----- Limites de qualidade de GPS (em metros) -----
FEG_GPS_ACC_HIGH_M=10.0
FEG_GPS_ACC_NORMAL_M=25.0
FEG_GPS_ACC_LOW_M=50.0

# ----- Thresholds de RSRP (dBm) -----
FEG_RSRP_EXCELENT_DBM=-85.0
FEG_RSRP_GOOD_DBM=-105.0

# ----- Servidor FastAPI -----
FEG_HOST=127.0.0.1
FEG_PORT=8000
FEG_MAX_UPLOAD_BYTES=26214400

# Recurso experimental; não identifica a coordenada oficial da antena.
FEG_ENABLE_SITE_REFERENCE=false

# ----- Overpass API (OSM) - User-Agent obrigatorio -----
# Em uso recorrente, substitua SEU_EMAIL por um contato válido.
FEG_HTTP_USER_AGENT=feg-unesp-rf/0.3 (+contact: SEU_EMAIL)
